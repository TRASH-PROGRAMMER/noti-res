{
    "compilerOptions": {
        "target": "ES2022",// Specify ECMAScript target version
        "module": "commonjs",// Specify module code generation
        "moduleResolution": "Node",// Specify module resolution strategy
        "ignoreDeprecations": "6.0",// Ignore deprecation warnings
        "strict": true,// Enable all strict type-checking options
        "esModuleInterop": true,// Enables emit interoperability between CommonJS and ES Modules
        "experimentalDecorators": true,// Enable experimental support for decorators
        "emitDecoratorMetadata": true,// Emit design-type metadata for decorated declarations
        "outDir": "./dist",// Output directory for compiled files
        "rootDir": "./src",// Root directory of input files
        "skipLibCheck": true,// Skip type checking of declaration files
        "forceConsistentCasingInFileNames": true// Force consistent casing in file names
    },
    "include": ["src/**/*.ts", "application/use-cases/SendNotification.ts", "application/use-cases/RegisterDevice.ts"],// Include all TypeScript files in the src directory
    "exclude": ["node_modules", "dist"]// Exclude node_modules and dist directories from compilation
  }
